    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "esbuild": "0.24.2",
    "motion": "12.4.7",
    "svelte": "5.19.0",
    "svelte-check": "4.1.4",
    "svgo": "4.0.0",
    "typescript": "5.8.3",
    "uplot": "1.6.31",
    "vite": "6.0.7"
  }
}
